<Page x:Class="VainTools.GpuGovernor.Views.GpuGovernorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VainTools.GpuGovernor.Controls"
             mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with GPU Selection and Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="GPU Governor" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="GpuComboBox"
                          Width="280"
                          VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.GpuList, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedGpu, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTipService.ToolTip="Select GPU"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Refresh metrics now"/>
                <Button Content="Start Monitoring"
                        Command="{x:Bind ViewModel.StartMonitoringCommand}"
                        ToolTipService.ToolTip="Start real-time monitoring"/>
                <Button Content="Stop Monitoring"
                        Command="{x:Bind ViewModel.StopMonitoringCommand}"
                        ToolTipService.ToolTip="Stop real-time monitoring"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12,8" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       FontSize="12" Opacity="0.8"/>
        </Border>

        <!-- Metrics Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Temperature Card -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Temperature" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.Temperature, Mode=OneWay, Converter={StaticResource TemperatureToColorConverter}}"/>
                        <TextBlock Text="°C" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                 Maximum="100" Margin="0,8,0,0" Height="4"
                                 Foreground="{x:Bind ViewModel.Temperature, Mode=OneWay, Converter={StaticResource TemperatureToColorConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Utilization Card -->
            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GPU Utilization" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Utilization, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="%" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.Utilization, Mode=OneWay}"
                                 Maximum="100" Margin="0,8,0,0" Height="4"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>

            <!-- Core Clock Card -->
            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Core Clock" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.CoreClock, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="MHz" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Memory Clock Card -->
            <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Memory Clock" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.MemoryClock, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="MHz" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Power Card -->
            <Border Grid.Row="2" Grid.Column="0" Margin="0,8,8,0" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Power Consumption" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Power, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="W" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Fan Speed Card -->
            <Border Grid.Row="2" Grid.Column="1" Margin="8,8,0,0" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Fan Speed" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.FanSpeed, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="%" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.FanSpeed, Mode=OneWay}"
                                 Maximum="100" Margin="0,8,0,0" Height="4"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GPU Controls Section -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Control Panel -->
            <Border Grid.Row="0" Margin="0,0,0,16" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                    IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="GPU Controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Fan Speed Control -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Fan Speed" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" StepFrequency="1"
                                    Value="{x:Bind ViewModel.TargetFanSpeed, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TargetFanSpeed, Mode=OneWay}"
                                       Width="40" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Apply"
                                    Command="{x:Bind ViewModel.SetFanSpeedCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </Grid>
                    </Grid>

                    <!-- Power Limit Control -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Power Limit (%)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="50" Maximum="150" StepFrequency="1"
                                    Value="{x:Bind ViewModel.TargetPowerLimit, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TargetPowerLimit, Mode=OneWay}"
                                       Width="40" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Apply"
                                    Command="{x:Bind ViewModel.SetPowerLimitCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </Grid>
                    </Grid>

                    <!-- Core Clock Offset Control -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Core Clock Offset (MHz)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-500" Maximum="500" StepFrequency="10"
                                    Value="{x:Bind ViewModel.CoreClockOffset, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CoreClockOffset, Mode=OneWay}"
                                       Width="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Apply"
                                    Command="{x:Bind ViewModel.SetCoreOffsetCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </Grid>
                    </Grid>

                    <!-- Memory Clock Offset Control -->
                    <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Memory Clock Offset (MHz)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-500" Maximum="500" StepFrequency="10"
                                    Value="{x:Bind ViewModel.MemoryClockOffset, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MemoryClockOffset, Mode=OneWay}"
                                       Width="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Apply"
                                    Command="{x:Bind ViewModel.SetMemoryOffsetCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Fan Curve Editor Section -->
            <Border Grid.Row="1" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fan Curve" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Load from GPU"
                                    Command="{x:Bind ViewModel.LoadFanCurveCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="Apply to GPU"
                                    Command="{x:Bind ViewModel.ApplyFanCurveCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="Reset All"
                                    Command="{x:Bind ViewModel.ResetCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Define fan speed at specific temperatures. Points are sorted by temperature."
                               FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>

                    <controls:FanCurveEditor Grid.Row="2"
                                             FanCurvePoints="{x:Bind ViewModel.FanCurvePoints, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
