<UserControl
    x:Class="AkariTools.App.Controls.SegmentedSettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared segmented row: two-segment Disabled | Enabled picker + label
         + optional description. Consumers bind Label/Description/SelectedIndex
         (OneWay, VM→control)/IsApplying and set SelectCommand; user picks flow
         through SelectCommand with the new index (boxed int); both segments
         disable while IsApplying is true. -->
    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
            <TextBlock
                Text="{x:Bind Label, Mode=OneWay}"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton
                    x:Name="DisabledSegment"
                    Content="Disabled"
                    Checked="Segment_Checked" />
                <RadioButton
                    x:Name="EnabledSegment"
                    Content="Enabled"
                    Checked="Segment_Checked" />
            </StackPanel>
            <TextBlock
                x:Name="DescriptionText"
                Text="{x:Bind Description, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
