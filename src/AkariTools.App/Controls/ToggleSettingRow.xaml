<UserControl
    x:Class="AkariTools.App.Controls.ToggleSettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared toggle row: switch + label (header) + optional description.
         Consumers bind Label/Description/IsOn/IsApplying and handle Toggled;
         the switch disables itself while IsApplying is true. -->
    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
        <StackPanel Spacing="4">
            <ToggleSwitch
                x:Name="Switch"
                Header="{x:Bind Label, Mode=OneWay}"
                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                Toggled="Switch_Toggled" />
            <TextBlock
                x:Name="DescriptionText"
                Text="{x:Bind Description, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
