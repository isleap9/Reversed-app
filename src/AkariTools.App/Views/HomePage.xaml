<Page
    x:Class="AkariTools.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTools.App.Controls"
    Loaded="Page_Loaded">

    <Grid x:Name="RootGrid">
        <!-- Star field background -->
        <controls:StarField x:Name="StarFieldCtrl" />

        <!-- Main content -->
        <Grid Padding="48,60,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title + Cards -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" Spacing="32">
                <StackPanel>
                    <TextBlock Text="Akari Toolbox" FontSize="36" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Optimization &amp; Management" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Hardware cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Processor -->
                    <Border Grid.Column="0" Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="20" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="Processor" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Hardware.Processor}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Graphics -->
                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="8,0">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="Graphics" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Hardware.Graphics}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Memory -->
                    <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="8,0">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE95D;" FontSize="20" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="Memory" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Hardware.Memory}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Motherboard -->
                    <Border Grid.Column="3" Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE7E4;" FontSize="20" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="Motherboard" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Hardware.Motherboard}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Right: Logo -->
            <Image Grid.Column="1" Source="/Assets/Logo.jpg" Width="200" Height="200" VerticalAlignment="Top" Margin="48,0,0,0" />

            <!-- Theme button bottom-right -->
            <Button
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Padding="12"
                Background="#1AFFFFFF"
                CornerRadius="20">
                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Light" Click="ThemeLight_Click" />
                        <MenuFlyoutItem Text="Dark" Click="ThemeDark_Click" />
                        <MenuFlyoutItem Text="Full Dark" Click="ThemeFullDark_Click" />
                        <MenuFlyoutItem Text="System" Click="ThemeSystem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Accent Color" Click="AccentColor_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Page>
