<Page
    x:Class="AkariTools.App.Views.General.VisualPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTools.App.Controls"
    xmlns:vm="using:AkariTools.App.ViewModels.General"
    Loaded="Page_Loaded">

    <!-- Visual page: data-driven rows over personalization and effects keys
         (spec §7.4), plus the display-only AppsUseLightTheme row.
         IsOn binds OneWay and user toggles flow through the ToggleCommand
         DP — a TwoWay binding would push IsOn to the VM before the
         command runs and trip the VM's same-value guard. -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Visual"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Personalization and Explorer visual effects."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsRepeater ItemsSource="{Binding Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingRowViewModel">
                            <controls:ToggleSettingRow
                                Label="{x:Bind Label, Mode=OneWay}"
                                Description="{x:Bind Description, Mode=OneWay}"
                                IsOn="{x:Bind IsOn, Mode=OneWay}"
                                ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- AppsUseLightTheme is display-only (spec §7.4): the app
                     theme system owns theme switching, so no toggle here. -->
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Apps use light theme"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding AppsUseLightThemeText}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="Display only — managed by the Windows theme setting."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
