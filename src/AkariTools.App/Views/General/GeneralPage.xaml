<Page
    x:Class="AkariTools.App.Views.General.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <!-- General page: Hyper-V / Spooler / RDP toggles.
         Switches bind OneWay and handlers pass the switch value explicitly:
         a TwoWay binding would push IsOn to the VM before Toggled fires and
         trip the same-value guard, deadening every toggle. -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="General"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Service and firmware toggles apply immediately."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Hyper-V -->
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <ToggleSwitch
                            x:Name="HyperVSwitch"
                            Header="Hyper-V"
                            IsOn="{Binding HyperVOn, Mode=OneWay}"
                            Toggled="HyperV_Toggled" />
                        <TextBlock
                            Text="Hypervisor launch type (bcdedit hypervisorlaunchtype). Requires a restart to take effect."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Print Spooler -->
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <ToggleSwitch
                            x:Name="SpoolerSwitch"
                            Header="Print Spooler"
                            IsOn="{Binding SpoolerOn, Mode=OneWay}"
                            Toggled="Spooler_Toggled" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Start mode: " />
                            <Run Text="{Binding SpoolerNote}" />
                        </TextBlock>
                        <TextBlock
                            Text="Print Spooler service start mode and running state."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Remote Desktop -->
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <ToggleSwitch
                            x:Name="RdpSwitch"
                            Header="Remote Desktop"
                            IsOn="{Binding RdpOn, Mode=OneWay}"
                            Toggled="Rdp_Toggled" />
                        <TextBlock
                            Text="Driven by fDenyTSConnections (0 = On); applies the TermService start mode and running state."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="{Binding LastError}"
                    FontSize="13"
                    Foreground="#FFFF6B60"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
