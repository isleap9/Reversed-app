<Page
    x:Class="AkariTools.App.Views.General.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTools.App.Controls"
    xmlns:vm="using:AkariTools.App.ViewModels.General"
    Loaded="Page_Loaded">

    <!-- Explorer page: data-driven rows over Explorer's Advanced values
         (spec §7.2). IsOn binds OneWay and user toggles flow through the
         ToggleCommand DP — a TwoWay binding would push IsOn to the VM
         before the command runs and trip the VM's same-value guard. -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Explorer"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Some changes require restarting Explorer to take effect."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsRepeater ItemsSource="{Binding Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingRowViewModel">
                            <controls:ToggleSettingRow
                                Label="{x:Bind Label, Mode=OneWay}"
                                Description="{x:Bind Description, Mode=OneWay}"
                                IsOn="{x:Bind IsOn, Mode=OneWay}"
                                ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
