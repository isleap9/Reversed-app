<Page
    x:Class="AkariTools.App.Views.General.SettingsVisibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariTools.App.ViewModels.General"
    Loaded="Page_Loaded">

    <!-- Settings Visibility page: toggle rows for Windows Settings pages
         (spec §7.6). Each toggle adds/removes a hide: URI in the
         SettingsPageVisibility REG_SZ at HKCU\...\Policies\Explorer. -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Settings Visibility"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Hide or show pages in Windows Settings. Changes apply immediately."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsRepeater ItemsSource="{Binding Pages}">
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsPageRow">
                            <Border
                                Background="#1AFFFFFF"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,8">
                                <ToggleSwitch
                                    Header="{x:Bind Name, Mode=OneWay}"
                                    IsOn="{x:Bind IsHidden, Mode=TwoWay}"
                                    Toggled="ToggleSwitch_Toggled" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
