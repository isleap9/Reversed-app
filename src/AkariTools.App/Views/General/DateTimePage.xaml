<Page
    x:Class="AkariTools.App.Views.General.DateTimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <!-- Date & Time page: NTP server list management (spec §7.5).
         Reads the current NtpServer value, allows adding/removing entries,
         and applies via w32tm + W32Time restart. -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Date &amp; Time"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Manage NTP time servers. Changes apply to the Windows time service."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Current NTP servers -->
                <TextBlock
                    Text="NTP Servers"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <ItemsRepeater ItemsSource="{Binding NtpServers}">
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border
                                Background="#1AFFFFFF"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,4">
                                <TextBlock
                                    Text="{x:Bind}"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Add new server -->
                <TextBlock
                    Text="Add NTP Server"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Margin="0,16,0,0" />

                <TextBlock
                    Text="e.g. time.windows.com or pool.ntp.org,0x9"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox
                    Text="{Binding NewServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Add NTP server (e.g. time.windows.com)"
                    Margin="0,8,0,0" />

                <!-- Error message -->
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    FontSize="13"
                    Foreground="#FFCC0000"
                    TextWrapping="Wrap" />

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                    <Button
                        Content="Add"
                        Command="{Binding AddServerCommand}"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Content="Apply NTP Servers"
                        Command="{Binding ApplyCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
