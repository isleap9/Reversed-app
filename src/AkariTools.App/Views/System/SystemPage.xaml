<Page
    x:Class="AkariTools.App.Views.System.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTools.App.Controls"
    xmlns:vm="using:AkariTools.App.ViewModels.General"
    Loaded="Page_Loaded">

    <!-- System screen, General tab (spec §6, §7.1): tab strip with disabled
         Performance/Security/Sound placeholders, a header action row, five
         expander cards, and the segmented rows. The Explorer, Context Menu,
         Visual, and Settings Visibility expanders host their existing VMs as
         ItemsRepeater rows exactly like the retired Views/General pages did:
         IsOn binds OneWay and user toggles flow through the ToggleCommand DP
         (a TwoWay binding would push IsOn to the VM before the command runs
         and trip the VM's same-value guard). -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="System"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- Tab strip: General active, later slices own the rest. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="General"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Content="Performance"
                        IsEnabled="False" />
                    <Button
                        Content="Security"
                        IsEnabled="False" />
                    <Button
                        Content="Sound"
                        IsEnabled="False" />
                </StackPanel>

                <!-- Task 7: header actions (Restart Explorer, Vain Defaults,
                     refresh). Present but disabled until Task 7 wires them. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Content="Restart Explorer"
                        IsEnabled="False" />
                    <Button
                        Content="Vain Defaults"
                        IsEnabled="False" />
                    <Button
                        Content="Refresh"
                        IsEnabled="False" />
                </StackPanel>

                <Expander
                    Header="Explorer"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{Binding Explorer.Rows}">
                        <ItemsRepeater.Layout>
                            <StackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingRowViewModel">
                                <controls:ToggleSettingRow
                                    Label="{x:Bind Label, Mode=OneWay}"
                                    Description="{x:Bind Description, Mode=OneWay}"
                                    IsOn="{x:Bind IsOn, Mode=OneWay}"
                                    ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                    Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <Expander
                    Header="Context Menu"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{Binding ContextMenu.Rows}">
                        <ItemsRepeater.Layout>
                            <StackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingRowViewModel">
                                <controls:ToggleSettingRow
                                    Label="{x:Bind Label, Mode=OneWay}"
                                    Description="{x:Bind Description, Mode=OneWay}"
                                    IsOn="{x:Bind IsOn, Mode=OneWay}"
                                    IsApplying="{x:Bind IsApplying, Mode=OneWay}"
                                    ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                    Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <Expander
                    Header="Visual"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <ItemsRepeater ItemsSource="{Binding Visual.Rows}">
                            <ItemsRepeater.Layout>
                                <StackLayout />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingRowViewModel">
                                    <controls:ToggleSettingRow
                                        Label="{x:Bind Label, Mode=OneWay}"
                                        Description="{x:Bind Description, Mode=OneWay}"
                                        IsOn="{x:Bind IsOn, Mode=OneWay}"
                                        ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                        Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- AppsUseLightTheme is display-only: the app theme
                             system owns theme switching, so no toggle here. -->
                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Apps use light theme"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="{Binding Visual.AppsUseLightThemeText}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="Display only — managed by the Windows theme setting."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander
                    Header="Date &amp; Time"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <!-- Task 5: full Date & Time expander content (timezone,
                             locale, format combos, live preview, NTP list). -->
                        <TextBlock
                            Text="Date &amp; time settings arrive in Task 5."
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander
                    Header="Settings Page Visibility"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{Binding SettingsVisibility.Pages}">
                        <ItemsRepeater.Layout>
                            <StackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsPageRow">
                                <Border
                                    Background="#1AFFFFFF"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,8">
                                    <ToggleSwitch
                                        Header="{x:Bind Name, Mode=OneWay}"
                                        IsOn="{x:Bind IsHidden, Mode=OneWay}"
                                        Toggled="ToggleSwitch_Toggled" />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <!-- Task 6: segmented Disabled | Enabled rows (Manual Windows
                     Updates, Print Service, Game Bar, Push Notifications). -->
                <TextBlock
                    Text="Manual Updates, Print Service, Game Bar, and Push Notifications segmented rows arrive in Task 6."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
