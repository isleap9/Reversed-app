<Page
    x:Class="AkariTools.App.Views.System.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTools.App.Controls"
    xmlns:vm="using:AkariTools.App.ViewModels.General"
    Loaded="Page_Loaded">

    <!-- System screen, General tab (spec §6, §7.1): tab strip with disabled
         Performance/Security/Sound placeholders, a header action row, five
         expander cards, and the segmented rows. The Explorer, Context Menu,
         Visual, and Settings Visibility expanders host their existing VMs as
         ItemsRepeater rows exactly like the retired Views/General pages did:
         IsOn binds OneWay and user toggles flow through the ToggleCommand DP
         (a TwoWay binding would push IsOn to the VM before the command runs
         and trip the VM's same-value guard). -->
    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="48,32,48,48"
                Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="System"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- Tab strip: General active, later slices own the rest. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="General"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Content="Performance"
                        IsEnabled="False" />
                    <Button
                        Content="Security"
                        IsEnabled="False" />
                    <Button
                        Content="Sound"
                        IsEnabled="False" />
                </StackPanel>

                <!-- Task 7: header actions (Restart Explorer, Vain Defaults,
                     refresh). Present and wired. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Content="Restart Explorer"
                        IsEnabled="True"
                        Command="{Binding RestartExplorerCommand, Mode=OneWay}" />
                    <Button
                        Content="Vain Defaults"
                        IsEnabled="True"
                        Command="{Binding ApplyDefaultsCommand, Mode=OneWay}" />
                    <Button
                        Content="Refresh"
                        IsEnabled="True"
                        Command="{Binding RefreshCommand, Mode=OneWay}" />
                </StackPanel>

                <Expander
                    Header="Explorer"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{Binding Explorer.Rows}">
                        <ItemsRepeater.Layout>
                            <StackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingRowViewModel">
                                <controls:ToggleSettingRow
                                    Label="{x:Bind Label, Mode=OneWay}"
                                    Description="{x:Bind Description, Mode=OneWay}"
                                    IsOn="{x:Bind IsOn, Mode=OneWay}"
                                    ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                    Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <Expander
                    Header="Context Menu"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{Binding ContextMenu.Rows}">
                        <ItemsRepeater.Layout>
                            <StackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingRowViewModel">
                                <controls:ToggleSettingRow
                                    Label="{x:Bind Label, Mode=OneWay}"
                                    Description="{x:Bind Description, Mode=OneWay}"
                                    IsOn="{x:Bind IsOn, Mode=OneWay}"
                                    IsApplying="{x:Bind IsApplying, Mode=OneWay}"
                                    ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                    Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <Expander
                    Header="Visual"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <ItemsRepeater ItemsSource="{Binding Visual.Rows}">
                            <ItemsRepeater.Layout>
                                <StackLayout />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingRowViewModel">
                                    <controls:ToggleSettingRow
                                        Label="{x:Bind Label, Mode=OneWay}"
                                        Description="{x:Bind Description, Mode=OneWay}"
                                        IsOn="{x:Bind IsOn, Mode=OneWay}"
                                        ToggleCommand="{x:Bind SetCommand, Mode=OneWay}"
                                        Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- AppsUseLightTheme is display-only: the app theme
                             system owns theme switching, so no toggle here. -->
                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Apps use light theme"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="{Binding Visual.AppsUseLightThemeText}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="Display only — managed by the Windows theme setting."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander
                    Header="Date &amp; Time"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <!-- Full Date & Time content (spec §5, §7.2): timezone,
                             locale, format combos, live preview, NTP list.
                             Combo selection commits immediate-on-select: the
                             TwoWay Selected*/SelectedItem/SelectedIndex
                             bindings push the picked value into the VM
                             property whose setter runs the serialized
                             per-combo write (failed writes revert + surface
                             an error). Format combo text is OneWay so typed
                             free text never writes. No code-behind selection
                             handlers. -->
                        <ComboBox
                            Header="Time zone"
                            ItemsSource="{Binding DateTime.TimeZones, Mode=OneWay}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="KeyName"
                            SelectedValue="{Binding DateTime.SelectedTimeZoneKey, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            Header="Region format"
                            ItemsSource="{Binding DateTime.Locales, Mode=OneWay}"
                            DisplayMemberPath="Display"
                            SelectedValuePath="Name"
                            SelectedValue="{Binding DateTime.SelectedLocale, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                        <!-- Format combos: Text is OneWay (typed free text never
                             pushes a write) while SelectedItem commits
                             discrete dropdown picks immediate-on-select. An
                             empty push (e.g. selection coercion) reverts
                             silently in the VM without writing. -->
                        <ComboBox
                            Header="Short date"
                            IsEditable="True"
                            ItemsSource="{Binding DateTime.ShortDates, Mode=OneWay}"
                            SelectedItem="{Binding DateTime.SelectedShortDate, Mode=TwoWay}"
                            Text="{Binding DateTime.SelectedShortDate, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            Header="Long date"
                            IsEditable="True"
                            ItemsSource="{Binding DateTime.LongDates, Mode=OneWay}"
                            SelectedItem="{Binding DateTime.SelectedLongDate, Mode=TwoWay}"
                            Text="{Binding DateTime.SelectedLongDate, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            Header="Short time"
                            IsEditable="True"
                            ItemsSource="{Binding DateTime.ShortTimes, Mode=OneWay}"
                            SelectedItem="{Binding DateTime.SelectedShortTime, Mode=TwoWay}"
                            Text="{Binding DateTime.SelectedShortTime, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            Header="Long time"
                            IsEditable="True"
                            ItemsSource="{Binding DateTime.LongTimes, Mode=OneWay}"
                            SelectedItem="{Binding DateTime.SelectedLongTime, Mode=TwoWay}"
                            Text="{Binding DateTime.SelectedLongTime, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            Header="First day of week"
                            ItemsSource="{Binding DateTime.FirstDayNames, Mode=OneWay}"
                            SelectedIndex="{Binding DateTime.SelectedFirstDayIndex, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="Preview"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="{Binding DateTime.PreviewShortDate, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{Binding DateTime.PreviewLongDate, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{Binding DateTime.PreviewShortTime, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{Binding DateTime.PreviewLongTime, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Text="NTP servers"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <ListView
                            x:Name="NtpListView"
                            ItemsSource="{Binding DateTime.NtpServers, Mode=OneWay}"
                            SelectionMode="Single" />
                        <TextBox
                            Header="Server"
                            PlaceholderText="time.windows.com"
                            Text="{Binding DateTime.NewServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Add"
                                Command="{Binding DateTime.AddServerCommand, Mode=OneWay}" />
                            <Button
                                Content="Edit"
                                Command="{Binding DateTime.EditNtpCommand, Mode=OneWay}"
                                CommandParameter="{Binding SelectedItem, ElementName=NtpListView, Mode=OneWay}" />
                            <Button
                                Content="Remove"
                                Command="{Binding DateTime.RemoveServerCommand, Mode=OneWay}"
                                CommandParameter="{Binding SelectedItem, ElementName=NtpListView, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Apply NTP servers"
                                Command="{Binding DateTime.ApplyCommand, Mode=OneWay}" />
                            <Button
                                Content="Sync time now"
                                Command="{Binding DateTime.SyncTimeNowCommand, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Text="{Binding DateTime.ErrorMessage, Mode=OneWay}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding DateTime.SyncMessage, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander
                    Header="Settings Page Visibility"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{Binding SettingsVisibility.Pages}">
                        <ItemsRepeater.Layout>
                            <StackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsPageRow">
                                <Border
                                    Background="#1AFFFFFF"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,8">
                                    <ToggleSwitch
                                        Header="{x:Bind Name, Mode=OneWay}"
                                        IsOn="{x:Bind IsHidden, Mode=OneWay}"
                                        Toggled="ToggleSwitch_Toggled" />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <!-- Task 6: segmented rows (Manual Windows Updates, Print
                     Service, Game Bar, Push Notifications). Each row binds
                     SelectedIndex OneWay with user picks flowing through
                     SelectCommand (a TwoWay binding would push SelectedIndex
                     to the VM before the command runs and trip the VM's
                     same-value guard). All four rows are bound to live host
                     VMs constructed in SystemPage code-behind. -->
                <controls:SegmentedSettingRow
                    Label="{Binding ManualUpdates.Label, Mode=OneWay}"
                    Description="{Binding ManualUpdates.Description, Mode=OneWay}"
                    SelectedIndex="{Binding ManualUpdates.SelectedIndex, Mode=OneWay}"
                    IsApplying="{Binding ManualUpdates.IsApplying, Mode=OneWay}"
                    SelectCommand="{Binding ManualUpdates.SelectCommand, Mode=OneWay}" />
                <TextBlock
                    Text="{Binding ManualUpdates.LastError, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                <controls:SegmentedSettingRow
                    Label="{Binding PrintService.Label, Mode=OneWay}"
                    Description="{Binding PrintService.Description, Mode=OneWay}"
                    SelectedIndex="{Binding PrintService.SelectedIndex, Mode=OneWay}"
                    IsApplying="{Binding PrintService.IsApplying, Mode=OneWay}"
                    SelectCommand="{Binding PrintService.SelectCommand, Mode=OneWay}" />
                <TextBlock
                    Text="{Binding PrintService.LastError, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                <controls:SegmentedSettingRow
                    Label="{Binding GameBar.Label, Mode=OneWay}"
                    Description="{Binding GameBar.Description, Mode=OneWay}"
                    SelectedIndex="{Binding GameBar.SelectedIndex, Mode=OneWay}"
                    IsApplying="{Binding GameBar.IsApplying, Mode=OneWay}"
                    SelectCommand="{Binding GameBar.SelectCommand, Mode=OneWay}" />
                <TextBlock
                    Text="{Binding GameBar.LastError, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                <controls:SegmentedSettingRow
                    Label="{Binding PushNotifications.Label, Mode=OneWay}"
                    Description="{Binding PushNotifications.Description, Mode=OneWay}"
                    SelectedIndex="{Binding PushNotifications.SelectedIndex, Mode=OneWay}"
                    IsApplying="{Binding PushNotifications.IsApplying, Mode=OneWay}"
                    SelectCommand="{Binding PushNotifications.SelectCommand, Mode=OneWay}" />
                <TextBlock
                    Text="{Binding PushNotifications.LastError, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
