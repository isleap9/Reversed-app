<Page
    x:Class="VainTools.App.Features.Apps.AppxManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:VainTools.App.Services">

    <Grid x:Name="AppxRoot" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Appx Manager" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Installed and provisioned Appx packages."
                           Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Elevation InfoBar -->
        <InfoBar x:Name="ElevationBar"
                 Grid.Row="1"
                 IsOpen="{Binding IsElevated, Converter={StaticResource InvertedBooleanConverter}}"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Administrator rights required"
                 Message="Some operations on this page require elevation. Run Vain Tools as administrator to perform them." />

        <!-- Scrolling content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel Spacing="16">

                <!-- Package List -->
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Installed &amp; Provisioned Packages" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run Text="{Binding Packages.Count}" /><Run Text=" packages" />
                        </TextBlock>
                        <TextBlock Text="No packages found. No installed or provisioned Appx packages were found on this system."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasPackages, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Packages}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:AppxPackage">
                                    <Grid Padding="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FullName}"
                                                       FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Provisioned"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding IsProvisioned, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="Installed"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding IsProvisioned, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove Package"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Command="{Binding DataContext.RemovePackageCommand, ElementName=AppxRoot}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <ProgressRing Grid.Row="3" Width="32" Height="32"
                      HorizontalAlignment="Center"
                      IsActive="{Binding IsLoading}"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
