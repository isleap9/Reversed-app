<Page
    x:Class="VainTools.App.Features.Apps.InstalledAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:VainTools.App.Services">

    <Grid x:Name="InstalledAppsRoot" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Installed Apps" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Programs from the uninstall registry."
                           Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Elevation warning (conditional) -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource InvertedBooleanConverter}}"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Administrator rights required"
                 Message="Some operations on this page require elevation. Run Vain Tools as administrator to perform them." />

        <!-- Search -->
        <TextBox Grid.Row="2"
                 PlaceholderText="Search programs…"
                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />

        <!--
            Scrolling content. The list lives in a "*" row: an Auto row would give it
            unbounded height and clip everything below it with no scrollbar.
        -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel Spacing="16">

                <!-- Program list card -->
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Programs" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProgramCountText}"
                                   Margin="0,4,0,0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No installed programs found. No programs with uninstall entries were found in the registry."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasPrograms, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Programs}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:InstalledApp">
                                    <Grid Padding="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Publisher}"
                                                       FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{Binding DisplayVersion}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Uninstall"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Command="{Binding DataContext.UninstallCommand, ElementName=InstalledAppsRoot}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Copy Command"
                                                Command="{Binding DataContext.CopyCommandCommand, ElementName=InstalledAppsRoot}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <ProgressRing Grid.Row="4" Width="32" Height="32"
                      HorizontalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
