<Page
    x:Class="VainTools.App.Features.Apps.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:VainTools.App.Services">

    <Grid x:Name="StoreRoot" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Store" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Search and install apps via winget."
                           Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Elevation warning (conditional) -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource InvertedBooleanConverter}}"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Administrator rights required"
                 Message="Some operations on this page require elevation. Run Vain Tools as administrator to perform them." />

        <!--
            Search. The page never searches on navigation: winget is only invoked when the
            user submits a query (Enter or the Search button) or presses Refresh.
        -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox Width="320"
                     PlaceholderText="Search apps…"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                     KeyDown="OnSearchKeyDown" />
            <Button Content="Search"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    VerticalAlignment="Center" />
        </StackPanel>

        <!--
            Scrolling content. The list lives in a "*" row: an Auto row would give it
            unbounded height and clip everything below it with no scrollbar.
        -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel Spacing="16">

                <!-- App list card -->
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Installable Apps" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppCountText}"
                                   Margin="0,4,0,0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No apps found. No installable apps matched your search. Try a different query."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Apps}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:StoreApp">
                                    <Grid Padding="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <!-- winget reports a source, not a publisher: the 12pt detail
                                                 line carries the reported version instead. -->
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{Binding Id}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Install"
                                                Command="{Binding DataContext.InstallAppCommand, ElementName=StoreRoot}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <ProgressRing Grid.Row="4" Width="32" Height="32"
                      HorizontalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
