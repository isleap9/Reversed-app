<Page
    x:Class="VainTools.App.Features.Startup.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VainTools.App.ViewModels"
    xmlns:services="using:VainTools.App.Services">

    <!--
        Both sections share one ScrollViewer in the "*" row, so the page scrolls as
        a whole and the scrollbar is always reachable. With a fixed Auto row the Run
        Keys card grew to its full content height and pushed the Scheduled Tasks card
        off-screen with nothing to scroll.
    -->
    <Grid x:Name="StartupRoot" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Startup" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Startup entries from Run keys and scheduled tasks."
                           Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Elevation InfoBar -->
        <InfoBar x:Name="ElevationBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Administrator rights required"
                 Message="Some settings on this page write to machine-wide keys. Run Vain Tools as administrator to change them." />

        <!-- Scrolling content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel Spacing="16">

                <!-- Run Key Entries -->
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Run Keys" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding RunKeyEntries}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:StartupEntry">
                                    <Grid Padding="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Command}"
                                                       FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Source}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      OnContent="" OffContent=""
                                                      IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                      Toggled="OnRunKeyToggled"
                                                      VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Delete"
                                                Command="{Binding DataContext.DeleteRunKeyEntryCommand, ElementName=StartupRoot}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Scheduled Tasks -->
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Scheduled Tasks" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding ScheduledTasks}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:StartupEntry">
                                    <Grid Padding="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Command}"
                                                       FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Scheduled Task"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      OnContent="" OffContent=""
                                                      IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                      Toggled="OnScheduledTaskToggled"
                                                      VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Delete"
                                                Command="{Binding DataContext.DeleteScheduledTaskCommand, ElementName=StartupRoot}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
