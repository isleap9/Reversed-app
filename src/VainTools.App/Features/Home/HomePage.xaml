<Page
    x:Class="VainTools.App.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:VainTools.App.Features.Home"
    xmlns:vm="using:VainTools.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Your system at a glance." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center" />
                    <Button Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>
            </Grid>

            <!-- System information cards -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Processor" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Info.Cpu, Mode=OneWay}"
                                   Style="{StaticResource InfoValueStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Motherboard" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Info.Motherboard, Mode=OneWay}"
                                   Style="{StaticResource InfoValueStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,8" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Operating System" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Info.OperatingSystem, Mode=OneWay}"
                                   Style="{StaticResource InfoValueStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.Info.OsVersion, Mode=OneWay}"
                                   FontSize="12" Opacity="0.7" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,8" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Info.InstalledRam, Mode=OneWay}"
                                   Style="{StaticResource InfoValueStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Graphics" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.Gpu, Mode=OneWay}"
                                       Style="{StaticResource InfoValueStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Driver Version" Style="{StaticResource InfoLabelStyle}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.Info.GpuDriverDisplay, Mode=OneWay}"
                                       Style="{StaticResource InfoValueStyle}" Margin="0,6,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quick actions -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="Quick actions" Style="{StaticResource SubtitleTextBlockStyle}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.QuickActions}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickAction">
                            <Button Width="230" Height="88" Margin="0,0,12,12"
                                    Padding="16,12"
                                    HorizontalContentAlignment="Left"
                                    Click="OnQuickActionClick"
                                    Tag="{x:Bind TargetTypeName}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20"
                                              VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   FontSize="11" Opacity="0.7"
                                                   TextWrapping="Wrap" Width="150" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
