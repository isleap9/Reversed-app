<UserControl x:Class="VainTools.App.Controls.FanCurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Add Point button -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fan Curve Editor" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Add Point" Click="AddPointButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>

        <!-- Curve visualization and point list -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Visual curve representation -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Canvas x:Name="CurveCanvas" SizeChanged="CurveCanvas_SizeChanged"/>
                    <TextBlock x:Name="NoPointsTextBlock" Text="No fan curve points defined"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.5" FontStyle="Italic"/>
                </Grid>
            </Border>

            <!-- Point list -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PointsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8" Padding="8" CornerRadius="4"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Temperature input -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Temp (°C)" FontSize="11" Opacity="0.7"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,2,0,0"
                                         Text="{Binding Temperature, Mode=TwoWay}"
                                         InputScope="Number"/>

                                <!-- Speed input -->
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Speed (%)" FontSize="11" Opacity="0.7" Margin="8,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="8,2,0,0"
                                         Text="{Binding SpeedPercent, Mode=TwoWay}"
                                         InputScope="Number"/>

                                <!-- Remove button -->
                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="0,8,0,0" Content="Remove Point"
                                        HorizontalAlignment="Stretch"
                                        Click="RemovePointButton_Click"
                                        Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
