<Page x:Class="VainTools.App.Views.GpuGovernorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:VainTools.App.Controls"
      xmlns:converters="using:VainTools.App.Converters"
      mc:Ignorable="d">

    <Page.Resources>
        <converters:TemperatureToColorConverter x:Key="TemperatureToColorConverter"/>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with GPU Selection and Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="GPU Governor" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="GpuComboBox"
                          Width="280"
                          VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.GpuList, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedGpu, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTipService.ToolTip="Select GPU"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh"
                        Command="{x:Bind ViewModel.RefreshMetricsCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Refresh metrics now"/>
                <Button Content="Start Monitoring"
                        Command="{x:Bind ViewModel.StartMonitoringCommand}"
                        ToolTipService.ToolTip="Start real-time monitoring"/>
                <Button Content="Stop Monitoring"
                        Command="{x:Bind ViewModel.StopMonitoringCommand}"
                        ToolTipService.ToolTip="Stop real-time monitoring"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12,8" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       FontSize="12" Opacity="0.8"/>
        </Border>

        <!-- Metrics Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Temperature Card -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Temperature" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.Temperature, Mode=OneWay, Converter={StaticResource TemperatureToColorConverter}}"/>
                        <TextBlock Text="°C" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                 Maximum="100" Margin="0,8,0,0" Height="4"
                                 Foreground="{x:Bind ViewModel.Temperature, Mode=OneWay, Converter={StaticResource TemperatureToColorConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Utilization Card -->
            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GPU Utilization" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Utilization, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="%" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.Utilization, Mode=OneWay}"
                                 Maximum="100" Margin="0,8,0,0" Height="4"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>

            <!-- Core Clock Card -->
            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Core Clock" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.CoreClock, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="MHz" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Memory Clock Card -->
            <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,8" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Memory Clock" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.MemoryClock, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="MHz" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Power Card -->
            <Border Grid.Row="2" Grid.Column="0" Margin="0,8,8,0" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Power Consumption" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Power, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="W" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Fan Speed Card -->
            <Border Grid.Row="2" Grid.Column="1" Margin="8,8,0,0" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Fan Speed" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.FanSpeed, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="%" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.FanSpeed, Mode=OneWay}"
                                 Maximum="100" Margin="0,8,0,0" Height="4"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>