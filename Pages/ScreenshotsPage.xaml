<Page x:Class="VainTools.Pages.ScreenshotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Width="600">
            <TextBlock Text="Screenshots" FontSize="24" FontWeight="Bold"/>
            <Button Content="Capture Screenshot" HorizontalAlignment="Left"/>
            <ListView x:Name="ScreenshotsList" Height="300">
                <ListViewItem Content="screenshot_2026-09-30_14-30-22.png"/>
                <ListViewItem Content="screenshot_2026-09-30_14-28-15.png"/>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>