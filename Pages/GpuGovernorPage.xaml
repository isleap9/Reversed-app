<Page x:Class="VainTools.Pages.GpuGovernorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Width="600">
            <TextBlock Text="GPU Governor" FontSize="24" FontWeight="Bold"/>

            <TextBlock Text="NVIDIA Settings" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Core Offset:" Width="160"/>
                    <Slider Minimum="-500" Maximum="500" Width="200"/>
                    <TextBlock Text="MHz" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Memory Offset:" Width="160"/>
                    <Slider Minimum="-500" Maximum="500" Width="200"/>
                    <TextBlock Text="MHz" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Power Limit:" Width="160"/>
                    <Slider Minimum="50" Maximum="150" Width="200"/>
                    <TextBlock Text="%" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Thermal Limit:" Width="160"/>
                    <Slider Minimum="60" Maximum="95" Width="200"/>
                    <TextBlock Text="°C" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Voltage Boost:" Width="160"/>
                    <Slider Minimum="-50" Maximum="50" Width="200"/>
                    <TextBlock Text="%" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fan Speed:" Width="160"/>
                    <Slider Minimum="0" Maximum="100" Width="200"/>
                    <TextBlock Text="%" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Fan Curve" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <Button Content="Edit Fan Curve" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Page>