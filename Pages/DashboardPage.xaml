<Page x:Class="VainTools.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                            <TextBlock Text="GPU:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,4"/>
                            <TextBlock Text="NVIDIA GeForce RTX 4090" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"/>
                            <TextBlock x:Name="GpuInfoText" Text="Temp: --°C\nFan: --%" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4"/>
            </Grid>
            <TextBlock Text="Active Profile" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <ComboBox x:Name="ProfileCombo" Width="300"/>
        </StackPanel>
    </ScrollViewer>
</Page>