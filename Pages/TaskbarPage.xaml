<Page x:Class="VainTools.Pages.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Width="600">
            <TextBlock Text="Taskbar" FontSize="24" FontWeight="Bold"/>

            <TextBlock Text="Start Menu" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <ComboBox x:Name="StartMenuCombo" Width="300">
                <ComboBoxItem Content="OpenShell (recommended)"/>
                <ComboBoxItem Content="Windows Start Menu"/>
            </ComboBox>

            <ToggleSwitch x:Name="RemoveStartMenuToggle" Header="Remove Start Menu &amp; Search" OffContent="Off"/>

            <TextBlock Text="Browser" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <ComboBox x:Name="BrowserCombo" Width="300">
                <ComboBoxItem Content="Helium"/>
                <ComboBoxItem Content="Mercury"/>
                <ComboBoxItem Content="Brave"/>
                <ComboBoxItem Content="Firefox"/>
                <ComboBoxItem Content="Chrome"/>
                <ComboBoxItem Content="Edge"/>
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</Page>