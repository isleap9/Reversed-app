<Page x:Class="VainTools.Pages.SystemTweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Width="600">
            <TextBlock Text="System Tweaks" FontSize="24" FontWeight="Bold"/>

            <TextBlock Text="Theme" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <ToggleSwitch x:Name="DarkThemeToggle" Header="Dark Theme" OnContent="On" OffContent="Off"/>

            <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <ToggleSwitch x:Name="NotificationsToggle" Header="Disable Notifications" OnContent="On" OffContent="Off"/>

            <TextBlock Text="Wallpaper" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <Button Content="Set Wallpaper" HorizontalAlignment="Left"/>

            <TextBlock Text="Power Plan" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <ComboBox x:Name="PowerPlanCombo" Width="300">
                <ComboBoxItem Content="Vain Power Plan"/>
                <ComboBoxItem Content="High Performance"/>
                <ComboBoxItem Content="Balanced"/>
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</Page>