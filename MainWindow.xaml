<Window
    x:Class="VainTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <StackPanel Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
            <TextBlock Text="VAIN TOOLS" FontSize="18" FontWeight="Bold"
                       Margin="16,20,16,24" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <NavigationView x:Name="NavView" PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            SelectedItem="{x:Bind SelectedNavItem}">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Dashboard" Tag="dashboard"
                                        FontSize="14" Margin="0,4"/>
                    <NavigationViewItem Content="GPU Governor" Tag="gpu"
                                        FontSize="14" Margin="0,4"/>
                    <NavigationViewItem Content="Profiles" Tag="profiles"
                                        FontSize="14" Margin="0,4"/>
                    <NavigationViewItem Content="System Tweaks" Tag="system"
                                        FontSize="14" Margin="0,4"/>
                    <NavigationViewItem Content="Screenshots" Tag="screenshots"
                                        FontSize="14" Margin="0,4"/>
                    <NavigationViewItem Content="Taskbar" Tag="taskbar"
                                        FontSize="14" Margin="0,4"/>
                </NavigationView.MenuItems>
            </NavigationView>
        </StackPanel>

        <!-- Content -->
        <Frame x:Name="ContentFrame" Grid.Column="1" Margin="24"/>
    </Grid>
</Window>